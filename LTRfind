#!/usr/bin/env bash

# 获取脚本所在路径
path1="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

#获取工作路径
work_path=${PWD}

# 引入配置文件
source "${path1}/config.ini"

# 解析命令行参数
while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--miu)
            miu="$2"
            shift 2
            ;;
        -t|--threads)
            threads="$2"
            shift 2
            ;;
        *)
            # 其他参数保持不变
            break
            ;;
    esac
done

# 激活conda环境函数
function activate() {
    condapath=$(conda info | awk -F': ' '/base environment/{print $2}' | xargs)
    source "${condapath}/etc/profile.d/conda.sh"
    conda deactivate
    conda activate "${envname}"
    conda list
    conda env list
}

# 检查ID长度是否超过13个字符
function checkID() {
    local genome=$1
    local temp_file="${path1}/temp.ID.txt"
    
    grep "^>" "${genome}" | cut -d ">" -f2 > "${temp_file}"
    
    while read -r line; do
        ID_len=${#line}
        echo "${line}的长度是${ID_len}"
        
        if [ ${ID_len} -gt 13 ]; then
            echo "错误: ID '${line}' 的长度超过13个字符，请使用seqkit修改ID后重新运行！" >&2
            rm -f "${temp_file}"
            exit 1
        fi
    done < "${temp_file}"
    
    rm -f "${temp_file}"
}

# 提取只包含染色体的序列
function getChr() {
    if [ $# -lt 2 ]; then
        echo "用法: getChr ChrString genome.fa" >&2
        exit 1
    fi

    local ChrStr=$1
    local genome=$2
    local filename="${genome%.*}"
    local temp_file="${path1}/temp.Chrlist.txt"
    
    grep "${ChrStr}" "${genome}" | cut -d ">" -f2 > "${temp_file}"
    # 检查临时文件是否为空
    if [ ! -s "${temp_file}" ]; then
        echo "错误: 未找到匹配 '${ChrStr}' 的染色体序列！请检查ChrString参数和基因组文件。" >&2
        rm -f "${temp_file}"
        exit 1
    fi
    "${seqkit}" grep -f "${temp_file}" "${genome}" | "${seqkit}" seq -i > "${filename}.chr.fa"
    rm -f "${temp_file}"
}

# 二倍体分析主函数
function Diploid() {
    if [ $# -lt 2 ]; then
        echo -e "\n用法: Diploid species genome.fa [ChrStr]\n注意: 仅适用于二倍体\n" >&2
        exit 1
    fi

    local species=$1
    local genome=$2
    local ChrStr=${3:-}
    local genomefile
    
    # 检查基因组文件是否存在
    if [ ! -e "${genome}" ]; then
        echo "错误: 基因组文件 ${genome} 不存在!" >&2
        exit 1
    fi
    # 如果提供了ChrStr参数，提取染色体序列
    if [ -n "${ChrStr}" ]; then
        getChr "${ChrStr}" "${genome}"
        genome="${genome%.*}.chr.fa"
    fi
    
    # 检查ID长度
    checkID "${genome}" || exit 1
    
    # LTR_FINDER分析
    if [ ! -e "${species}.finder.scn" ]; then
        echo "开始LTR_FINDER分析..."
        ${perl} ${LTR_FINDER_parallel} -seq ${genome} -threads ${threads} -harvest_out \
            -finder "${path1}/LTR_FINDER_parallel-1.1/bin/LTR_FINDER.x86_64-1.0.7" || {
            echo "LTR_FINDER_parallel分析失败!" >&2
            exit 1
        }
        
        genomefile=$(basename "${genome}")
        mv "${genomefile}.finder.combine.scn" "${species}.finder.scn"
    else
        echo "已存在输出文件 ${species}.finder.scn, 跳过LTR_FINDER分析。"
    fi
    
    # LTRharvest分析
    if [ ! -e "${species}.harvest.scn" ]; then
        echo "开始LTRharvest分析..."
         ${perl} ${LTR_HARVEST_parallel} -seq ${genome} -threads ${threads} -gt ${gt} || {
            echo "LTRharvest分析失败!" >&2
            exit 1
        }
        genomefile=$(basename "${genome}")
        mv ${genomefile}.harvest.combine.scn ${species}.harvest.scn
    else
        echo "已存在输出文件 ${species}.harvest.scn, 跳过LTRharvest分析。"
    fi
    
    # LTR_retriever分析
    echo "开始LTR_retriever分析..."
    LTR_retriever -genome "${genome}" -inharvest "${species}.harvest.scn" \
        -infinder "${species}.finder.scn" -threads "${threads}" -u "${miu}" || {
        echo "LTR_retriever分析失败!" >&2
        exit 1
    }
    
    # 数据可视化
    echo "生成可视化结果..."
    rev "${genome}.pass.list" | awk '{print $1,$2,$3}' | rev | tr " " "\t" > "${species}.LTR_time.xls"
    $Rscript "${path1}/visualization/visual_LAI.R" "${genome}.out.LAI" "${species}" ${work_path}
    $Rscript "${path1}/visualization/visual_LTR.R" "${species}.LTR_time.xls" "${species}" ${work_path}
}

# 多倍体分析函数
function Polyploid() {
    local species genome ChrStr ploidy1 ploidy2 ploidy3 ploidy4
    
    # 参数解析
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)
                show_polyploid_help
                exit 0
                ;;
            -abbr) species="$2"; shift 2 ;;
            -g|-genome) genome="$2"; shift 2 ;;
            -chr) ChrStr="$2"; shift 2 ;;
            -p1|-ploidy1) ploidy1="$2"; shift 2 ;;
            -p2|-ploidy2) ploidy2="$2"; shift 2 ;;
            -p3|-ploidy3) ploidy3="$2"; shift 2 ;;
            -p4|-ploidy4) ploidy4="$2"; shift 2 ;;
            *) echo "未知参数: $1" >&2; exit 1 ;;
        esac
    done
    
    # 检查必要参数
    if [ -z "${species}" ] || [ -z "${genome}" ]; then
        echo "错误: 必须提供物种缩写和基因组文件!" >&2
        show_polyploid_help
        exit 1
    fi
    
    # 检查基因组文件
    if [ ! -e "${genome}" ]; then
        echo "错误: 基因组文件 ${genome} 不存在!" >&2
        exit 1
    fi
    
    local filename="${genome%.*}"
    local chr_genome
    
    # 处理染色体序列
    if [ -n "${ChrStr}" ]; then
        chr_genome="${filename}.chr.fa"
        getChr "${ChrStr}" "${genome}" || exit 1
    else
        chr_genome="${genome}"
    fi
    
    # 检查ID长度
    checkID "${chr_genome}" || exit 1
    
    # 创建倍性文件列表
    create_ploidy_lists "${chr_genome}" "${ploidy1}" "${ploidy2}" "${ploidy3}" "${ploidy4}" || exit 1
    
    # 执行二倍体分析
    Diploid "${species}" "${chr_genome}"
    
    # 对各倍性进行LAI分析
    local ploidies=(${ploidy1} ${ploidy2} ${ploidy3} ${ploidy4})
    for ploidy in "${ploidies[@]}"; do
        if [ -n "${ploidy}" ] && [ -e "${ploidy}.ploidy.list.txt" ]; then
            echo "开始分析 ${ploidy}.ploidy.list.txt - $(date)"
            LAI -genome "${chr_genome}" -intact "${chr_genome}.pass.list" -all "${chr_genome}.out" -mono "${ploidy}.ploidy.list.txt"
            ${Rscript} ${path1}/visualization/visual_LAI.R "${ploidy}.ploidy.list.txt.LAI" "${ploidy}" ${work_path}
        fi
    done
}

# 显示多倍体帮助信息
function show_polyploid_help() {
    echo -e "
用法: 
Polyploid -abbr 物种缩写 -g 基因组文件 [-chr ChrString] 
          -p1 倍性1字符 [-p2 倍性2字符] [-p3 倍性3字符] [-p4 倍性4字符]

选项:
  -abbr      物种缩写
  -g, -genome 基因组文件(非压缩)
  -chr       染色体标识字符串(如: chr或Chr), 可选
  -p1, -ploidy1 倍性1的标识字符
  -p2, -ploidy2 倍性2的标识字符(可选)
  -p3, -ploidy3 倍性3的标识字符(可选)
  -p4, -ploidy4 倍性4的标识字符(可选)

注意: 最多支持八倍体(4个倍性标识)

示例:
  LTRfind Polyploid -abbr Species -g genome.fa -chr ChrString -p1 Ghir_A -p2 Ghir_D
  LTRfind Polyploid -abbr Species -g genome.fa -p1 Ghir_A -p2 Ghir_D -p3 Ghir_B
"
}

# 创建倍性列表文件
function create_ploidy_lists() {
    local genome=$1
    shift
    
    for ploidy in "$@"; do
        if [ -n "${ploidy}" ]; then
            grep "^>" "${genome}" | grep "${ploidy}" | cut -d ">" -f2 > "${ploidy}.ploidy.list.txt" || {
                echo "错误: 无法创建 ${ploidy}.ploidy.list.txt" >&2
                return 1
            }
        fi
    done
    return 0
}

# 显示主帮助信息
function show_main_help() {
    echo -e "
用途:
  获取基因组中的LTR反转录转座子并计算基因组的LAI值

用法:
  -h|--help       显示此帮助信息
  -u|--miu        指定miu参数值(可选，默认为config.ini中的值,7e-9)
  -t|--threads    指定线程数(可选，默认为config.ini中的值,36)
  -D|Diploid      二倍体分析
  -P|Polyploid    多倍体分析(最高支持八倍体)
  -V|--version    显示版本信息

二倍体示例:
  LTRfind -D A.thaliana /path/A.thaliana.fa
  LTRfind Diploid A.thaliana /path/A.thaliana.fa chr
  LTRfind -u 2e-9 -t 16 -D A.thaliana /path/A.thaliana.fa

多倍体示例:
  LTRfind -P -abbr Species -g genome.fa -chr ChrString -p1 Ghir_A -p2 Ghir_D
  LTRfind -u 7e-9 -t 36 -P -abbr Species -g genome.fa -p1 Ghir_A -p2 Ghir_D -p3 Ghir_C

注意:
  1. 运行-D或Diploid时，如果提供ChrString参数，将只分析染色体序列(不分析scaffold)
  2. 如果基因组ID格式为'>1'这样，不能使用ChrStr参数来过滤scaffold
  3. 基因组序列ID长度不能超过13个字符
  4. 如果指定-u或和-t参数，则这2个参数必须在最前面，如果不指定则使用config.ini中的默认值
"
}


# 主程序
case "${1:-}" in
    -h|--help)
        show_main_help
        ;;
    -D|Diploid)
        shift
        Diploid "$@"
        echo "分析成功完成!"
        ;;
    -P|Polyploid)
        shift
        Polyploid "$@"
        echo "所有分析成功完成!"
        ;;
    -V|--version)
        echo -e "版本: V0.4\n作者: Mol Chai\n邮箱: chaimol@163.com"
        ;;
    *)
        echo "输入错误，请输入 -h 查看帮助信息" >&2
        exit 1
        ;;
esac